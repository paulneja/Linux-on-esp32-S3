@@ -57,6 +57,61 @@
 pid_t forkpty(int *amaster, char *name, struct termios *termp,
 	      struct winsize *winp);
 #endif
+#ifndef HAVE_OPENPTY
+int openpty(int *amaster, int *aslave, char *name, struct termios *termp,
+	    struct winsize *winp);
+#endif
+
+/* A vfork() child may not return from the function that called vfork(), and
+** forkpty() returns in the child, so the pty setup and the exec live in one
+** frame. The child makes syscalls only; its error goes out with write(),
+** since the stdio buffers belong to the suspended parent. */
+static pid_t
+spawnpty(int *amaster, struct termios *termp, char **argv, int statusfd)
+{
+	int master, slave;
+	pid_t pid;
+
+	if (openpty(&master, &slave, NULL, termp, NULL) < 0)
+		return -1;
+
+	pid = vfork();
+	if (pid < 0)
+	{
+		close(master);
+		close(slave);
+		return -1;
+	}
+	else if (pid == 0)
+	{
+		setsid();
+#ifdef TIOCSCTTY
+		if (ioctl(slave, TIOCSCTTY, NULL) < 0)
+			_exit(1);
+#endif
+		dup2(slave, 0);
+		dup2(slave, 1);
+		dup2(slave, 2);
+		if (slave > 2)
+			close(slave);
+		close(master);
+
+		execvp(*argv, argv);
+
+		if (statusfd != -1)
+			dup2(statusfd, 1);
+		else
+			write(1, EOS "\r\n", sizeof(EOS "\r\n") - 1);
+		write(1, progname, strlen(progname));
+		write(1, ": could not execute ", 20);
+		write(1, *argv, strlen(*argv));
+		write(1, "\r\n", 2);
+		_exit(1);
+	}
+	close(slave);
+	*amaster = master;
+	return pid;
+}
 
