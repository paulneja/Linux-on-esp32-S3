From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Max Filippov <jcmvbkbc@gmail.com>
Date: Fri, 30 Jun 2023 08:22:20 -0700
Subject: [PATCH 26/61] esp_wifi: constify tables and rearrange adapter
 initialization

Signed-off-by: Max Filippov <jcmvbkbc@gmail.com>
(cherry picked from commit c0d182744670036cdb9b1ad4b9615b483a1c754c)
---
 drivers/net/wireless/espressif/esp32-ng/esp.h         |  2 +-
 .../net/wireless/espressif/esp32-ng/esp_cfg80211.c    |  2 +-
 drivers/net/wireless/espressif/esp32-ng/esp_if.h      |  2 +-
 drivers/net/wireless/espressif/esp32-ng/main.c        | 11 ++++++++---
 4 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/espressif/esp32-ng/esp.h b/drivers/net/wireless/espressif/esp32-ng/esp.h
index c320214bd765b..f0ea313483bfe 100644
--- a/drivers/net/wireless/espressif/esp32-ng/esp.h
+++ b/drivers/net/wireless/espressif/esp32-ng/esp.h
@@ -85,7 +85,7 @@ struct esp_adapter {
 	 * struct esp_sdio_context */
 	void                    *if_context;
 
-	struct esp_if_ops       *if_ops;
+	const struct esp_if_ops *if_ops;
 
 	/* Private for each interface */
 	struct esp_wifi_device  *priv[ESP_MAX_INTERFACE];
diff --git a/drivers/net/wireless/espressif/esp32-ng/esp_cfg80211.c b/drivers/net/wireless/espressif/esp32-ng/esp_cfg80211.c
index ad8551ecb8ae2..4975c77123952 100644
--- a/drivers/net/wireless/espressif/esp32-ng/esp_cfg80211.c
+++ b/drivers/net/wireless/espressif/esp32-ng/esp_cfg80211.c
@@ -597,7 +597,7 @@ static int esp_cfg80211_get_tx_power(struct wiphy *wiphy,
 	return 0;
 }
 
-static struct cfg80211_ops esp_cfg80211_ops = {
+static const struct cfg80211_ops esp_cfg80211_ops = {
 #if 0
 	.add_virtual_intf = esp_cfg80211_add_iface,
 	.del_virtual_intf = esp_cfg80211_del_iface,
diff --git a/drivers/net/wireless/espressif/esp32-ng/esp_if.h b/drivers/net/wireless/espressif/esp32-ng/esp_if.h
index 2439db896ecb4..5d42acc2a1c3d 100644
--- a/drivers/net/wireless/espressif/esp32-ng/esp_if.h
+++ b/drivers/net/wireless/espressif/esp32-ng/esp_if.h
@@ -20,7 +20,7 @@ struct esp_if_ops {
 int esp_init_interface_layer(struct esp_adapter *adapter, u32 speed);
 void esp_deinit_interface_layer(void);
 
-int esp_wifi_init(struct esp_adapter *adapter);
+int esp_wifi_init(struct esp_adapter *adapter, const struct esp_if_ops *if_ops);
 void esp_wifi_deinit(struct esp_adapter *adapter);
 
 #endif
diff --git a/drivers/net/wireless/espressif/esp32-ng/main.c b/drivers/net/wireless/espressif/esp32-ng/main.c
index e00123aae5de0..4d8a19d2d829c 100644
--- a/drivers/net/wireless/espressif/esp32-ng/main.c
+++ b/drivers/net/wireless/espressif/esp32-ng/main.c
@@ -894,10 +894,12 @@ static void esp_events_work(struct work_struct *work)
 	dev_kfree_skb_any(skb);
 }
 
-static int init_adapter(struct esp_adapter *adapter)
+static int init_adapter(struct esp_adapter *adapter, const struct esp_if_ops *if_ops)
 {
 	memset(adapter, 0, sizeof(*adapter));
 
+	adapter->if_ops = if_ops;
+
 	/* Prepare interface RX work */
 	adapter->if_rx_workqueue = alloc_workqueue("ESP_IF_RX_WORK_QUEUE", 0, 0);
 
@@ -970,9 +972,9 @@ static void esp_reset(void)
 }
 
 
-int esp_wifi_init(struct esp_adapter *adapter)
+int esp_wifi_init(struct esp_adapter *adapter, const struct esp_if_ops *if_ops)
 {
-	return init_adapter(adapter);
+	return init_adapter(adapter, if_ops);
 }
 
 void esp_wifi_deinit(struct esp_adapter *adapter)
@@ -988,6 +990,9 @@ void esp_wifi_deinit(struct esp_adapter *adapter)
 	}
 	clear_bit(ESP_DRIVER_ACTIVE, &adapter->state_flags);
 
+	esp_remove_card(adapter);
+	if (adapter->hcidev)
+		esp_deinit_bt(adapter);
 	deinit_adapter(adapter);
 
 	if (resetpin != HOST_GPIO_PIN_INVALID) {
-- 
2.55.0

