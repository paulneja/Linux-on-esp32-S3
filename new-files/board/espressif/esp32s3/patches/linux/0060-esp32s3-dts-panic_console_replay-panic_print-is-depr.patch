From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paulneja <207793167+paulneja@users.noreply.github.com>
Date: Fri, 2 Oct 2026 23:05:41 -0300
Subject: [PATCH 60/61] esp32s3 dts: panic_console_replay, panic_print is
 deprecated in 7.x

---
 arch/xtensa/boot/dts/esp32s3.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/xtensa/boot/dts/esp32s3.dtsi b/arch/xtensa/boot/dts/esp32s3.dtsi
index e6452ca469b0c..045e9f717093b 100644
--- a/arch/xtensa/boot/dts/esp32s3.dtsi
+++ b/arch/xtensa/boot/dts/esp32s3.dtsi
@@ -8,7 +8,7 @@ / {
 	interrupt-parent = <&pic>;
 
 	chosen {
-		bootargs = "earlycon=esp32s3uart,mmio32,0x60000000,115200n8,40000000 console=ttyGS3 console=ttyS0,115200n8 quiet rw root=mtd:rootfs rootfstype=cramfs panic=10 panic_print=0x20 ";
+		bootargs = "earlycon=esp32s3uart,mmio32,0x60000000,115200n8,40000000 console=ttyGS3 console=ttyS0,115200n8 quiet rw root=mtd:rootfs rootfstype=cramfs panic=10 panic_console_replay ";
 	};
 
 	aliases {
