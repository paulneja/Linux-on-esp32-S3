+		list_add(&cmd_node->list, &adapter->cmd_pending_queue);
 	else
-		list_add_tail_rcu(&cmd_node->list, &adapter->cmd_pending_queue);
+		list_add_tail(&cmd_node->list, &adapter->cmd_pending_queue);
 
