 .../espressif/esp32-ng/esp_cfg80211.c         | 39 +++++++----
 .../net/wireless/espressif/esp32-ng/esp_cmd.c | 69 ++++++++++++-------
 .../net/wireless/espressif/esp32-ng/esp_cmd.h | 12 +++-
 .../wireless/espressif/esp32-ng/esp_shmem.c   | 55 +++++++++++----
 .../net/wireless/espressif/esp32-ng/main.c    | 32 ++++++---
 6 files changed, 149 insertions(+), 63 deletions(-)

diff --git a/drivers/net/wireless/espressif/esp32-ng/Kconfig b/drivers/net/wireless/espressif/esp32-ng/Kconfig
index efcb624f877bc..a88105094ef42 100644
--- a/drivers/net/wireless/espressif/esp32-ng/Kconfig
+++ b/drivers/net/wireless/espressif/esp32-ng/Kconfig
@@ -3,11 +3,6 @@
 config ESP32_WIFI
 	tristate "Espressif esp32/esp32sx/esp32cx devices"
 	depends on CFG80211
-	select WIRELESS_EXT
-	select CRYPTO
-	select CRYPTO_SKCIPHER
-	select WEXT_SPY
-	select WEXT_PRIV
 	help
 	  This is the standard Linux driver to support wifi on esp32 device
 	  family.
