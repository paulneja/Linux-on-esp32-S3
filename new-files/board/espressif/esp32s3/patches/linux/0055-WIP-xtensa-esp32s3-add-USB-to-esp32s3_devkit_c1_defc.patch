From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Max Filippov <jcmvbkbc@gmail.com>
Date: Thu, 25 Jul 2024 08:12:27 -0700
Subject: [PATCH 55/73] WIP: xtensa: esp32s3: add USB to
 esp32s3_devkit_c1_defconfig

Signed-off-by: Max Filippov <jcmvbkbc@gmail.com>
(cherry picked from commit 026a5e1a237e569c50debc381561095ed025856f)
---
 arch/xtensa/configs/esp32s3_devkit_c1_defconfig | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/arch/xtensa/configs/esp32s3_devkit_c1_defconfig b/arch/xtensa/configs/esp32s3_devkit_c1_defconfig
index c42177f1ca63f..56bfd178796f5 100644
--- a/arch/xtensa/configs/esp32s3_devkit_c1_defconfig
+++ b/arch/xtensa/configs/esp32s3_devkit_c1_defconfig
@@ -56,6 +56,9 @@ CONFIG_MTD_BLOCK=y
 CONFIG_MTD_ESP32=y
 CONFIG_MTD_PHYSMAP=y
 CONFIG_MTD_PHYSMAP_OF=y
+CONFIG_SCSI=y
+CONFIG_BLK_DEV_SD=y
+# CONFIG_SCSI_LOWLEVEL is not set
 CONFIG_NETDEVICES=y
 # CONFIG_NET_CORE is not set
 # CONFIG_ETHERNET is not set
@@ -101,7 +104,10 @@ CONFIG_GPIO_GENERIC_PLATFORM=y
 CONFIG_POWER_RESET=y
 CONFIG_POWER_RESET_SYSCON=y
 # CONFIG_HWMON is not set
-# CONFIG_USB_SUPPORT is not set
+CONFIG_USB=y
+CONFIG_USB_ACM=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_DWC2=y
 CONFIG_MMC=y
 # CONFIG_PWRSEQ_EMMC is not set
 # CONFIG_PWRSEQ_SIMPLE is not set
@@ -112,6 +118,7 @@ CONFIG_IIO=y
 CONFIG_INV_MPU6050_I2C=y
 CONFIG_RESET_CONTROLLER=y
 CONFIG_RESET_SIMPLE=y
+CONFIG_PHY_ESP32S3_USB=y
 # CONFIG_NVMEM is not set
 # CONFIG_DNOTIFY is not set
 # CONFIG_INOTIFY_USER is not set
