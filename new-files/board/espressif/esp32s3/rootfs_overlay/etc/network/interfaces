# interface file auto-generated by buildroot, then replaced by this project

auto lo
iface lo inet loopback

auto espsta0
iface espsta0 inet dhcp
	# Without this the board takes a lease with no name on it, so the
	# router lists it as unnamed and every instruction in the README
	# starts with "find the IP address first".
	hostname esp32s3
	post-up wpa_supplicant -i espsta0 -c /etc/wpa_supplicant.conf -B
	# killall sulks when theres nothing to kill
	pre-down killall -q wpa_supplicant || true
