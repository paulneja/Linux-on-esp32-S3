#!/bin/sh
start() {
	/usr/sbin/home-init &
	pid=$!
	n=0
	while kill -0 "$pid" 2>/dev/null; do
		if [ "$n" -ge 45 ]; then
			echo "S06home-users: home-init still running after 45s, continuing boot" >&2
			return 0
		fi
		sleep 1
		n=$((n + 1))
	done
	wait "$pid"
}
case "$1" in
    start|restart|reload) start ;;
    stop) : ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
