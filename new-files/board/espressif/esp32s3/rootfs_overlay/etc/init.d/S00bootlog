#!/bin/sh
#
# Unmute the console at boot when `bootlog verbose` asked for it. Raising the
# level only affects what comes next, so the buffer is replayed once for what
# came before. S00 so the gap is as small as an init script can make it.

FLAG=${BOOTLOG_DIR:-/etc/bootlog}/verbose
LEVEL=${BOOTLOG_LEVEL:-/proc/sys/kernel/printk}

case "$1" in
	start)
		[ -e "$FLAG" ] || exit 0
		echo 8 > "$LEVEL" 2>/dev/null || exit 0
		echo 'bootlog: verbose; replaying the log buffered before init'
		dmesg || :
		;;
	stop)
		;;
	restart|reload)
		"$0" start
		;;
	status)
		if [ -e "$FLAG" ]; then echo 'bootlog: verbose'; else echo 'bootlog: quiet'; fi
		;;
	*)
		echo "usage: $0 {start|stop|restart|status}" >&2
		exit 1
		;;
esac
