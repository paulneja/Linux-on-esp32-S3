#!/bin/sh
#
# Carry the network and the accounts across an update. Every flash rewrites
# /etc; /home survives flash.sh --parts, so the credentials are copied there
# and put back when /etc comes from the factory. That is decided by a
# generation stamp, not by a missing file: a restore happens only when /etc
# carries no stamp at all. An /etc with its stamp is live, whatever was
# deleted from it. /home/.etc-backup/disabled turns this off.

# Overridable so build/test-keepconfig.py can drive this on a host with a
# fake /etc and /home rather than a board.
: "${KEEP_ETC:=/etc}"
: "${KEEP_BACKUP:=/home/.etc-backup}"
: "${KEEP_MOUNTS:=/proc/mounts}"

BACKUP=$KEEP_BACKUP
STAMP=$KEEP_ETC/.keepconfig-generation
FILES="wpa_supplicant.conf shadow passwd group"
KEYS="dropbear/dropbear_rsa_host_key dropbear/dropbear_ecdsa_host_key dropbear/dropbear_ed25519_host_key dropbear/dropbear_dss_host_key"

# A random id. /dev/urandom is always there; the fallback is good enough to
# tell two /etc generations apart, which is all the stamp is for.
new_generation() {
	if [ -r /dev/urandom ]; then
		od -An -N8 -tx1 /dev/urandom | tr -d ' \n'
	else
		printf '%s-%s' "$(date +%s 2>/dev/null)" "$$"
	fi
	echo
}

home_is_writable() {
	awk -v want="${KEEP_HOME:-/home}" \
	    '$2 == want && $4 ~ /(^|,)rw(,|$)/ { found = 1 }
	     END { exit !found }' "$KEEP_MOUNTS"
}

# "dir/file" needs its directory created; a bare "file" does not -- and
# ${1%/*} returns the whole word when there is no slash in it.
make_parent() {
	case $1 in
	*/*) mkdir -p "$2/${1%/*}" 2>/dev/null ;;
	esac
}

save_one() {
	[ -f "$KEEP_ETC/$1" ] || return 0
	make_parent "$1" "$BACKUP"
	# Write beside the target and rename, so a power cut during the write
	# cannot leave a half-copied credential file behind.
	cp -p "$KEEP_ETC/$1" "$BACKUP/$1.new" 2>/dev/null || return 0
	mv "$BACKUP/$1.new" "$BACKUP/$1" 2>/dev/null
}

# Only ever called once the caller has established that /etc came back from
# the factory, so overwriting is the point. Skip a file that already matches
# to save a jffs2 write.
restore_one() {
	[ -f "$BACKUP/$1" ] || return 0
	cmp -s "$BACKUP/$1" "$KEEP_ETC/$1" && return 0
	make_parent "$1" "$KEEP_ETC"
	cp -p "$BACKUP/$1" "$KEEP_ETC/$1.new" 2>/dev/null || return 0
	mv "$KEEP_ETC/$1.new" "$KEEP_ETC/$1" 2>/dev/null && echo "  restored /etc/$1"
}

case "$1" in
	start)
		[ -e "$BACKUP/disabled" ] && exit 0
		home_is_writable || exit 0
		[ -d "$BACKUP" ] || exit 0
		# The gate. A stamped /etc is a live one: leave it alone, no
		# matter what it is missing. Only an /etc with no stamp at all
		# was just rewritten from an image, and only then is what the
		# board had before worth putting back.
		[ -e "$STAMP" ] && exit 0
		# Nothing to restore unless a save actually happened.
		[ -f "$BACKUP/generation" ] || exit 0
		echo 'Restoring the configuration saved before this update:'
		for f in $FILES $KEYS; do restore_one "$f"; done
		# Stamp the restored /etc with the generation it now carries, so
		# the next boot sees a live /etc and does nothing.
		cp -p "$BACKUP/generation" "$STAMP" 2>/dev/null
		echo '  (delete /home/.etc-backup, or touch /home/.etc-backup/disabled, to stop this)'
		;;
	stop)
		[ -e "$BACKUP/disabled" ] && exit 0
		home_is_writable || exit 0
		mkdir -p "$BACKUP" 2>/dev/null || exit 0
		chmod 700 "$BACKUP" 2>/dev/null
		# A live /etc gets a stamp the first time it is saved; an /etc
		# that already has one keeps it, so the id names this /etc for
		# as long as it exists.
		if [ ! -e "$STAMP" ]; then
			new_generation > "$STAMP.new" 2>/dev/null &&
				mv "$STAMP.new" "$STAMP" 2>/dev/null
		fi
		for f in $FILES $KEYS; do save_one "$f"; done
		# The backup records which /etc it came from.
		cp -p "$STAMP" "$BACKUP/generation.new" 2>/dev/null &&
			mv "$BACKUP/generation.new" "$BACKUP/generation" 2>/dev/null
		;;
	save) "$0" stop && echo "Configuration saved to $BACKUP" ;;
	restart|reload) "$0" stop; "$0" start ;;
	*) echo "Usage: $0 {start|stop|save}" >&2; exit 1 ;;
esac
