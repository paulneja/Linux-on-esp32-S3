#!/bin/sh

FACTORY=changeme123
ETC=${FIRST_LOGIN_ETC:-/etc}
CHOICE=$ETC/remote-login

[ -e "$CHOICE" ] && exit 0

trap 'echo; exit 1' INT TERM

root_hash() {
	sed -n 's/^root:\([^:]*\):.*/\1/p' "$ETC/shadow"
}

factory_password() {
	hash=$(root_hash)
	[ -n "$hash" ] || return 0
	case $hash in
	'$1$'*) method=md5 ;;
	'$5$'*) method=sha256 ;;
	'$6$'*) method=sha512 ;;
	*) return 1 ;;
	esac
	salt=${hash#\$?\$}
	salt=${salt%%\$*}
	[ "$(mkpasswd -m $method "$FACTORY" "$salt" 2>/dev/null)" = "$hash" ]
}

if factory_password; then
	echo
	echo "This board still has the factory password. Pick a new one for root."
	tries=0
	while :; do
		tries=$((tries + 1))
		[ "$tries" -le 3 ] || exit 1
		passwd root || continue
		factory_password || break
		echo "That is the factory password, or an empty one. Pick another."
	done
fi

echo
echo "Which way in over the network? Only the one you pick is turned on."
if [ -x "${FIRST_LOGIN_DROPBEAR:-/usr/sbin/dropbear}" ]; then
	echo "  1) SSH     encrypted, slow to connect on this board"
	echo "  2) Telnet  clear text, only on a LAN you trust"
	echo "  3) None    console only"
	while :; do
		printf "Pick 1, 2 or 3: "
		read -r answer || exit 1
		case $answer in
		1) remote-login ssh; break ;;
		2) remote-login telnet; break ;;
		3) remote-login off; break ;;
		esac
	done
else
	echo "  1) Telnet  clear text, only on a LAN you trust"
	echo "  2) None    console only"
	while :; do
		printf "Pick 1 or 2: "
		read -r answer || exit 1
		case $answer in
		1) remote-login telnet; break ;;
		2) remote-login off; break ;;
		esac
	done
fi
echo "Change it later with: remote-login ssh|telnet|off"
echo
