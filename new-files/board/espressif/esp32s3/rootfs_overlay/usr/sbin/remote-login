#!/bin/sh
set -e

if [ "$(id -u)" != 0 ]; then
	echo "remote-login: must be run as root" >&2
	exit 1
fi

CONF=/etc/inetd.conf
CHOICE=/etc/remote-login
SSH_LINE='ssh	stream	tcp	nowait	root	/usr/sbin/dropbear	dropbear -i -R -I 600'
TELNET_LINE='telnet	stream	tcp	nowait	root	/usr/sbin/telnetd	telnetd -i'

restart_inetd() {
	killall -HUP inetd 2>/dev/null || /etc/init.d/S45inetd start
}

use() {
	if [ "$1" = ssh ]; then line=$SSH_LINE; else line=$TELNET_LINE; fi
	tmp=$CONF.new
	sed -e 's/^ssh\([ 	]\)/#ssh\1/' -e 's/^telnet\([ 	]\)/#telnet\1/' \
		"$CONF" > "$tmp" 2>/dev/null || : > "$tmp"
	if grep -q "^#$1[ 	]" "$tmp"; then
		sed -i "s/^#$1\([ 	]\)/$1\1/" "$tmp"
	else
		printf '%s\n' "$line" >> "$tmp"
	fi
	mv "$tmp" "$CONF"
	echo "$1" > "$CHOICE"
	restart_inetd
}

case "$1" in
ssh)
	if [ ! -x /usr/sbin/dropbear ]; then
		echo "remote-login: this image has no SSH server" >&2
		exit 1
	fi
	use ssh
	echo "SSH on, telnet off."
	;;
telnet)
	use telnet
	echo "Telnet on, SSH off. Telnet sends the password in clear text."
	;;
status|"")
	on=
	grep -q '^ssh[ 	]' "$CONF" && on="$on ssh"
	grep -q '^telnet[ 	]' "$CONF" && on="$on telnet"
	echo "Listening:${on:- nothing}"
	;;
*)
	echo "usage: remote-login {ssh|telnet|status}" >&2
	exit 1
	;;
esac
