#!/bin/sh
set -e
CONF=/etc/inetd.conf
PORT=80
DOCROOT=/home/www
enabled() { grep -q "^$PORT[ 	]" "$CONF"; }
restart_inetd() {
    killall inetd 2>/dev/null || :
    /usr/sbin/inetd
}
migrate() {
    test "$(id -u)" = 0
    id www-data >/dev/null
    test "$(id -u www-data)" != 0
    awk '$0 ~ /^#?80[ \t]/ && ($8 != "-i" || $9 != "-h" ||
        ($10 != "/www" && $10 != "/home/www") || $6 != "/usr/sbin/httpd") { exit 1 }' "$CONF" || {
        echo 'web-server: port 80 has a custom configuration; not changed' >&2
        return 1
    }
    tmp=$(mktemp /etc/inetd.web.XXXXXX)
    cp -p "$CONF" "$tmp"
    awk '$0 ~ /^#?80[ \t]/ {
        prefix = substr($0,1,1)=="#" ? "#" : ""
        print prefix "80\tstream\ttcp\tnowait\twww-data\t/usr/sbin/httpd\thttpd -i -h /home/www"
        next
    } {print}' "$CONF" > "$tmp"
    if ! cmp -s "$CONF" "$tmp"; then
        if [ ! -e /etc/inetd.conf.before-home-www ]; then cp -p "$CONF" /etc/inetd.conf.before-home-www; fi
        mv "$tmp" "$CONF"
        killall -HUP inetd 2>/dev/null || :
    else
        rm "$tmp"
    fi
}
case "${1:-status}" in
    migrate) migrate ;;
    on|enable)
        migrate
        test -r "$DOCROOT/index.html" || { echo 'web-server: missing /home/www/index.html' >&2; exit 1; }
        if enabled; then echo 'Web server already enabled (/home/www, www-data)'; exit 0; fi
        if grep -q '^#80[ 	]' "$CONF"; then
            sed -i 's/^#80\([ 	]\)/80\1/' "$CONF"
        else
            printf '80\tstream\ttcp\tnowait\twww-data\t/usr/sbin/httpd\thttpd -i -h /home/www\n' >> "$CONF"
        fi
        restart_inetd
        echo 'Web server enabled: port 80, /home/www, user www-data (persists across boots).'
        ;;
    off|disable)
        test "$(id -u)" = 0
        if enabled; then
            sed -i 's/^80\([ 	]\)/#80\1/' "$CONF"
            restart_inetd
        fi
        echo 'Web server disabled.'
        ;;
    status)
        if enabled; then echo 'Web server enabled: port 80, /home/www, user www-data'
        else echo 'Web server disabled: content in /home/www'; fi
        ;;
    *) echo 'Usage: web-server {on|off|status|migrate}' >&2; exit 2 ;;
esac
