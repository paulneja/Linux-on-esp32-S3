#!/bin/sh
set -e

if [ "$(id -u)" != 0 ]; then
	echo "ssh-server: must be run as root" >&2
	exit 1
fi

ETC=${REMOTE_LOGIN_ETC:-/etc}
CHOICE=$ETC/remote-login

others() {
	[ -r "$CHOICE" ] || return 0
	for word in $(cat "$CHOICE"); do
		case $word in
		ssh|off) ;;
		*) printf '%s ' "$word" ;;
		esac
	done
	return 0
}

on() {
	grep -qw ssh "$CHOICE" 2>/dev/null
}

case "$1" in
on|enable)
	if on; then
		echo "SSH is already enabled."
		exit 0
	fi
	echo "$(others)ssh" > "$CHOICE"
	remote-login apply >/dev/null
	echo "SSH enabled (starts on boot too). Disable with: ssh-server off"
	;;
off|disable)
	if on; then
		rest=$(others)
		echo "${rest:-off}" > "$CHOICE"
		remote-login apply >/dev/null
	fi
	echo "SSH disabled."
	;;
status|"")
	if on; then
		echo "SSH: enabled"
	else
		echo "SSH: disabled"
	fi
	;;
*)
	echo "usage: ssh-server {on|off|status}" >&2
	exit 1
	;;
esac
