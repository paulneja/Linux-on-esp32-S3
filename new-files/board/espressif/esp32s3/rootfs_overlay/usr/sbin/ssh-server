#!/bin/sh
set -e

if [ "$(id -u)" != 0 ]; then
	echo "ssh-server: must be run as root" >&2
	exit 1
fi

CONF=/etc/inetd.conf
SSH_LINE='ssh	stream	tcp	nowait	root	/usr/sbin/dropbear	dropbear -i -R -I 600'

restart_inetd() {
	# BusyBox inetd rereads inetd.conf on SIGHUP. Killing and relaunching it
	# by hand desynchronised the pidfile that S45inetd owns, and left a
	# window with no inetd at all if the rebind lost the race.
	killall -HUP inetd 2>/dev/null || /etc/init.d/S45inetd start
}

case "$1" in
on|enable)
	if grep -q '^ssh[ 	]' "$CONF"; then
		echo "SSH is already enabled."
		exit 0
	fi
	if grep -q '^#ssh[ 	]' "$CONF"; then
		sed -i 's/^#ssh\([ 	]\)/ssh\1/' "$CONF"
	else
		printf '%s\n' "$SSH_LINE" >> "$CONF"
	fi
	restart_inetd
	echo "SSH enabled (starts on boot too). Disable with: ssh-server off"
	;;
off|disable)
	if grep -q '^ssh[ 	]' "$CONF"; then
		sed -i 's/^ssh\([ 	]\)/#ssh\1/' "$CONF"
		restart_inetd
	fi
	echo "SSH disabled. Telnet is still available."
	;;
status|"")
	if grep -q '^ssh[ 	]' "$CONF"; then
		echo "SSH: enabled"
	else
		echo "SSH: disabled (telnet only)"
	fi
	;;
*)
	echo "usage: ssh-server {on|off|status}" >&2
	exit 1
	;;
esac
