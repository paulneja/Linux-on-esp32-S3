#!/bin/sh

DEV=/dev/esp-ble
IFACE=espsta0
CONF=/etc/wpa_supplicant.conf
LIST=/run/ble-scan
CR=$(printf '\r')
TAB=$(printf '\t')

[ -e "$DEV" ] || exit 0

exec 3<> "$DEV" || exit 1

n=0
while [ ! -e "/sys/class/net/$IFACE" ]; do
	n=$((n + 1))
	[ "$n" -gt 60 ] && break
	sleep 1
done

say() {
	printf '%s\r\n' "$1" >&3
}

LINE=""
# Reading a dialog answer: bounded, because BLE.md documents phones dropping
# the link mid-session. Without the timeout the daemon stays parked here and
# the next session's first byte is read as this session's answer.
read_line() {
	IFS= read -r -t "${1:-120}" LINE <&3 || return 1
	LINE=${LINE%"$CR"}
	return 0
}

# The outer loop waits for someone to show up, so it must not time out.
read_wake() {
	IFS= read -r LINE <&3 || return 1
	LINE=${LINE%"$CR"}
	return 0
}

connect_and_report() {
	_ssid="$1"
	_pass="$2"

	if [ -n "$_pass" ]; then
		wifi connect "$_ssid" "$_pass" >/dev/null 2>&1
	else
		wifi connect "$_ssid" >/dev/null 2>&1
	fi

	_n=0
	_ip=""
	while [ "$_n" -lt 20 ]; do
		_ip=$(ip -4 addr show "$IFACE" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p')
		[ -n "$_ip" ] && break
		_n=$((_n + 1))
		sleep 1
	done

	if [ -n "$_ip" ]; then
		say ""
		say "Connected to '$_ssid'"
		say "IP address: $_ip"
		say "You can telnet to it from your LAN now."
	else
		say ""
		say "Joined '$_ssid' but got no IP (wrong password?)."
		say "Send anything to try again."
	fi
}

do_dialog() {
	say ""
	say "=== Linux on ESP32-S3 - WiFi setup ==="

	_n=0
	while [ ! -e "/sys/class/net/$IFACE" ]; do
		[ "$_n" = 0 ] && say "WiFi is still starting up, hold on..."
		_n=$((_n + 1))
		if [ "$_n" -gt 30 ]; then
			say "WiFi interface never appeared. Send anything to retry."
			return
		fi
		sleep 1
	done

	say "Scanning, please wait..."

	_try=0
	while :; do
		wifi scan --tsv > "$LIST" 2>/dev/null
		[ -s "$LIST" ] && break
		_try=$((_try + 1))
		if [ "$_try" -ge 3 ]; then
			say "No networks found. Send anything to retry."
			return
		fi
		say "Nothing yet, scanning again..."
		sleep 3
	done

	say ""
	_i=0
	while IFS="$TAB" read -r _sig _sec _name; do
		_i=$((_i + 1))
		[ "$_sec" = OPEN ] && _lock=open || _lock=locked
		say "  $_i) $_name  ($_lock, $_sig)"
	done < "$LIST"
	say ""
	say "Send the number of the network:"

	read_line || return
	case "$LINE" in
	''|*[!0-9]*)
		say "Not a number - cancelled."
		return
		;;
	esac

	# Read the chosen row from the tab separated list. "read" with IFS set to
	# a tab keeps the SSID verbatim: runs of spaces survive, and nothing is
	# glob expanded the way "set -- $line" used to do.
	_ssid=""
	_sec=""
	_i=0
	while IFS="$TAB" read -r _sig _f2 _f3; do
		_i=$((_i + 1))
		if [ "$_i" = "$LINE" ]; then
			_sec="$_f2"
			_ssid="$_f3"
			break
		fi
	done < "$LIST"

	if [ -z "$_ssid" ]; then
		say "No network with that number."
		return
	fi

	if [ "$_sec" = OPEN ]; then
		say "'$_ssid' is open - connecting..."
		connect_and_report "$_ssid" ""
	else
		say "Password for '$_ssid':"
		read_line || return
		if [ -z "$LINE" ]; then
			say "No password given - cancelled."
			return
		fi
		say "Connecting to '$_ssid'..."
		connect_and_report "$_ssid" "$LINE"
	fi
}

while read_wake; do
	do_dialog
	# On a network the dialog has done its job; "ble-prov on" keeps it.
	if [ ! -e /etc/ble-prov/always ] && [ -s "$CONF" ]; then
		say ""
		say "WiFi is configured; closing the setup channel."
		say "Re-enable it from the board with: ble-prov on"
		exit 0
	fi
done
