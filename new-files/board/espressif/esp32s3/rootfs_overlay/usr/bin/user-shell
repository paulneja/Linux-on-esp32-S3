#!/bin/sh
# Mirror only root's primary serial login. The child re-enters this wrapper
# on a PTY; the environment guard prevents recursion and keeps shell preferences.
if [ "$#" -eq 0 ] && [ -t 0 ] && [ -z "${PAPERBOARD_MIRROR_ACTIVE-}" ] &&
   [ ! -e /etc/paperboard-no-mirror ] && [ -c /dev/epd ] &&
   [ -x /usr/bin/epd-shell ] && [ "$(id -u)" = 0 ]; then
    case "$(tty 2>/dev/null)" in
        /dev/ttyS0)
            export PAPERBOARD_MIRROR_ACTIVE=1
            exec /usr/bin/epd-shell /usr/bin/user-shell
            ;;
    esac
fi
pref=
if [ -n "${HOME-}" ] && [ -r "$HOME/.shell" ]; then
    read -r pref < "$HOME/.shell" 2>/dev/null || pref=
fi
if [ "$pref" = dash ] && [ -x /usr/bin/dash ]; then
    if [ "$#" -eq 0 ]; then ENV=/etc/dash-resume exec /usr/bin/dash -i; fi
    exec /usr/bin/dash "$@"
fi
if [ -x /bin/bash ]; then
    if [ "$#" -eq 0 ]; then exec /bin/bash -l; fi
    exec /bin/bash "$@"
fi
if [ "$#" -eq 0 ]; then exec /bin/busybox sh -l; fi
exec /bin/busybox sh "$@"
