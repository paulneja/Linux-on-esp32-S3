#!/bin/sh
if [ "$#" -eq 0 ] && [ ! -e /etc/remote-login ] && [ -t 0 ] &&
   [ -x /usr/sbin/first-login ] && [ "$(id -u)" = 0 ]; then
    /usr/sbin/first-login || exit 1
fi
pref=
if [ -n "${HOME-}" ] && [ -r "$HOME/.shell" ]; then
    read -r pref < "$HOME/.shell" 2>/dev/null || pref=
fi
if [ "$pref" = dash ] && [ -x /usr/bin/dash ]; then
    if [ "$#" -eq 0 ]; then ENV=/etc/dash-resume exec /usr/bin/dash -l -i; fi
    exec /usr/bin/dash "$@"
fi
if [ -x /bin/bash ]; then
    if [ "$#" -eq 0 ]; then exec /bin/bash -l; fi
    exec /bin/bash "$@"
fi
if [ "$#" -eq 0 ]; then exec /bin/busybox sh -l; fi
exec /bin/busybox sh "$@"
