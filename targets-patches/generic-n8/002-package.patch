@@ -30,9 +30,22 @@ cron_patch="$repo_dir/new-files/board/espressif/esp32s3/package-patches/busybox/
 if ! patch -d "$source_dir" -p1 -R --force --dry-run < "$cron_patch" >/dev/null 2>&1; then
     patch -d "$source_dir" -p1 --forward --batch < "$cron_patch"
 fi
+# Generic N8: enable vi in the BusyBox variant actually installed in rootfs.
+# This source tree is copied from Buildroot and has its own .config.
+if grep -qx '# CONFIG_VI is not set' "$source_dir/.config"; then
+    sed -i 's/^# CONFIG_VI is not set$/CONFIG_VI=y/' "$source_dir/.config"
+fi
+grep -qx 'CONFIG_VI=y' "$source_dir/.config" || {
+    echo 'ERROR: BusyBox CONFIG_VI was not enabled' >&2
+    exit 1
+}
