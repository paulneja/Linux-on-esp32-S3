+++ b/new-files/board/espressif/esp32s3/rootfs_overlay/usr/sbin/home-init
@@ -1,7 +1,7 @@
 #!/bin/sh
 set -e
 test "$(id -u)" = 0
-awk '$2 == "/home" && $3 == "jffs2" && $4 ~ /(^|,)rw(,|$)/ { found=1 }
+awk '$2 == "/home" && ($3 == "jffs2" || $3 == "ext2") && $4 ~ /(^|,)rw(,|$)/ { found=1 }
