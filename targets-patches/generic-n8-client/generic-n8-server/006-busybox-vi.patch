@@ -76,5 +76,5 @@
         install(PROGRAMS / 'busybox-with-netcat', tree / 'bin/busybox')
-        for name in ('nc', 'netcat', 'stat'):
+        for name in ('nc', 'netcat', 'stat', 'vi'):
             path = tree / 'bin' / name
             remove(path)
             path.symlink_to('busybox')
