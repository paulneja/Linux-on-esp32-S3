diff --git a/new-files/toplevel/apply-local-changes.sh b/new-files/toplevel/apply-local-changes.sh
--- a/new-files/toplevel/apply-local-changes.sh
+++ b/new-files/toplevel/apply-local-changes.sh
@@ -52,2 +52,19 @@ buildroot)
+	# Generic N8 Client only: limit Dropbear compilation to dbclient.
+	# This runs after cloning Buildroot, before its configuration and build.
+	dropbear_mk=package/dropbear/dropbear.mk
+	[ -f "$dropbear_mk" ] || {
+		echo "error: missing $dropbear_mk" >&2
+		exit 1
+	}
+	if grep -q '^DROPBEAR_PROGRAMS[[:space:]]*[:?+]*=' "$dropbear_mk"; then
+		sed -i -E 's/^DROPBEAR_PROGRAMS[[:space:]]*[:?+]*=.*/DROPBEAR_PROGRAMS = dbclient/' "$dropbear_mk"
+	else
+		echo "error: DROPBEAR_PROGRAMS not found in $dropbear_mk" >&2
+		exit 1
+	fi
+	grep -qx 'DROPBEAR_PROGRAMS = dbclient' "$dropbear_mk" || {
+		echo "error: failed to select dbclient-only build" >&2
+		exit 1
+	}
 	cd ../..
 	echo ">>> buildroot: copying new files (board profile, espctl, init scripts)"
