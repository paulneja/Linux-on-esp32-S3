diff --git a/experiments/mmu-poc/programs/build-netcat.sh b/experiments/mmu-poc/programs/build-netcat.sh
--- a/experiments/mmu-poc/programs/build-netcat.sh
+++ b/experiments/mmu-poc/programs/build-netcat.sh
@@ -19,6 +19,16 @@
 if [[ ! -d "$source_dir" ]]; then
     cp -a --reflink=auto "$original" "$source_dir"
 fi
+# Generic N8 Client: disable server applets in the separate BusyBox tree.
+# Do not depend on the Buildroot BusyBox config: this tree is reused between builds.
+for applet in HTTPD TELNETD INETD DNSD; do
+    sed -i -E "s/^CONFIG_${applet}=y$/# CONFIG_${applet} is not set/" "$source_dir/.config"
+    grep -qx "# CONFIG_${applet} is not set" "$source_dir/.config" || {
+        echo "ERROR: failed to disable BusyBox CONFIG_${applet}" >&2
+        exit 1
+    }
+done
+
 apply_program_patch "$source_dir" busybox-nc.patch
 apply_program_patch "$source_dir" busybox-login.patch
 apply_program_patch "$source_dir" busybox-users.patch
@@ -38,4 +48,11 @@
 install -m 755 "$source_dir/busybox_unstripped" "$programs_out/$output.debug"
 "$prefix-strip" --strip-unneeded -R .xt.prop -R .xt.lit \
     -o "$programs_out/$output" "$source_dir/busybox_unstripped"
+# Reject builds if oldconfig or later steps re-enabled any server applet.
+for applet in HTTPD TELNETD INETD DNSD; do
+    grep -qx "# CONFIG_${applet} is not set" "$source_dir/.config" || {
+        echo "ERROR: BusyBox CONFIG_${applet} re-enabled during build" >&2
+        exit 1
+    }
+done
 "$prefix-size" "$programs_out/$output"
